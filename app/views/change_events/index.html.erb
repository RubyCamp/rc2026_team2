<% content_for :title, "変更一覧表示" %>
<% current_review_status_label = if params[:review_status].blank?
                                      "全て"
                                    elsif params[:review_status].to_s == "pending"
                                      "未確認"
                                    else
                                      "確認済"
                                    end %>

<section class="card shadow-sm">
  <div class="card-body">
    <h2 class="h4 card-title">
      変更記録
    </h2>

    <h5>
      <%= form_with url: change_events_path, method: :get do |form| %>
        <%= form.select :review_status, [["未確認", :pending], ["確認済", :reviewed]], include_blank: "全て" %>
        <%= form.submit "検索" %>
      <% end %>
    </h5>
  </div>
</section>
<br>
<h5>
  <div class="d-flex align-items-center gap-2 mb-4">

    <span class="fw-semibold">未確認件数</span>
    <span class="badge rounded-pill text-bg-primary">
      <%= aa=  ChangeEvent.pending_count %>件
    </span>
  </div>
</h5>

<p class="mb-3 small text-body-secondary">
  表示中: <strong><%= current_review_status_label %></strong>
</p>
<hr>
<section class="card shadow-sm">
  <div class="card-body">
    <h2 class="h4 card-title">
      変更一覧
    </h2>
    <ul class="list-group list-group-flush">
      <% @change_events.each do |change_event| %>
        <li class="list-group-item px-0
        d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center gap-3">
          <span>
            <strong>
              <% if change_event.review_status == "reviewed" %>
                <span class="d-inline-flex justify-content-center align-items-center border border-2 border-success text-success rounded-3 fw-bold" style="width: 3rem; height: 3rem;">
                  既読
                </span>
              <% else %>
                <span class="d-inline-flex justify-content-center align-items-center border border-2 border-danger text-danger rounded-3 fw-bold" style="width: 3rem; height: 3rem;">
                  未読
                </span>
              <% end %>
            </strong>
            <br>
            <small class="text-body-secondary">
              <% if change_event.review_status == "reviewed" %>

                <%= l change_event.reviewed_at, format: :long %>

              <% else %>

                -------------------------

              <% end %>
            </small>
          </span>
          <span>
            <span class="badge rounded-pill text-bg-danger">
              <% case change_event.target_type %>
                <% when "work_request" %>
                  勤務依頼
                <% when "availability" %>
                  勤務可否
                <% when "assignment" %>
                  スタッフ割り当て
              <% end %>
            </span>
            <span class="badge rounded-pill text-bg-warning">
              <% case change_event.action_type %>
                <% when "created" %>
                  登録
                <% when "updated" %>
                  更新
                <% when "assigned" %>
                  割当
                <% when "unassigned" %>
                  割当解除
                <% when "confirmed" %>
                  確定
              <% end %>
            </span>
            <br>
            <span class="badge rounded-pill text-bg-dark">
              <% if change_event.source == "seed" %>
                <%= change_event.target_id %>
              <% elsif change_event.source == "debug" %>
                D
              <% end %>
            </span>
            <strong><%= change_event.summary %></strong>
            <br>

            <small class="text-body-secondary">
              <%= l change_event.occurred_at, format: :long %>
            </small>
          </span>
          <% if change_event.review_status == "pending" %>
            <%= button_to "既読にする",
              change_event_path(change_event),
              method: :patch,
                form: {
                  data: {
                    turbo_confirm:
                    "この変更記録を既読にします"
                  }
                },
                class: "btn btn-success btn-lg"
            %>
          <% else %>
            <%= button_to "未読にする",
              change_event_path(change_event),
              method: :patch,
                form: {
                  data: {
                    turbo_confirm:
                    "この変更記録を未読にします"
                  }
                },
                class: "btn btn-danger btn-lg"
            %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
